# SPDX-License-Identifier: AGPL-3.0-or-later
[Desktop Entry]
Name=Porch Canary
GenericName=Instant Messenger
Comment=Canary build of Porch
Exec=porch-canary %U
TryExec=porch-canary
Icon=porch-canary
Type=Application
Categories=Network;InstantMessaging;Chat;
Keywords=chat;im;messaging;messenger;voip;voice;video;call;
StartupWMClass=porch-canary
SingleMainWindow=true
StartupNotify=true
MimeType=x-scheme-handler/porch-canary;
Terminal=false
X-GNOME-UsesNotifications=true
Actions=open-settings;new-dm;

[Desktop Action open-settings]
Name=Open Settings
Exec=porch-canary --fluxer-task=open-settings %U

[Desktop Action new-dm]
Name=New Direct Message
Exec=porch-canary --fluxer-task=new-dm %U
