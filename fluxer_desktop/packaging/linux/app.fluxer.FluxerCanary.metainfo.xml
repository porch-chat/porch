<component type="desktop-application">
    <id>app.fluxer.FluxerCanary</id>
    <launchable type="desktop-id">app.fluxer.FluxerCanary.desktop</launchable>
    <name>Porch Canary</name>
    <developer id="chat.porch">
        <name>Porch</name>
    </developer>
    <summary>Pre-release Porch client</summary>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>AGPL-3.0-or-later</project_license>
    <icon type="stock">porch-canary</icon>
    <description>
        <p>Porch Canary is the pre-release channel for Porch, a privately operated communication app for close friends built on a detached Fluxer fork.</p>
        <p>It supports text messaging, voice and video calls, screen sharing, communities, channels, direct messages, group chats, emoji, and reactions.</p>
    </description>
    <categories>
        <category>Network</category>
        <category>InstantMessaging</category>
        <category>Chat</category>
    </categories>
    <keywords>
        <keyword>chat</keyword>
        <keyword>messaging</keyword>
        <keyword>voice</keyword>
        <keyword>video</keyword>
        <keyword>screen sharing</keyword>
    </keywords>
    <branding>
        <color type="primary">#2563EB</color>
    </branding>
    <url type="bugtracker">https://github.com/porch-chat/porch/issues</url>
    <url type="homepage">https://canary.porch.chat</url>
    <url type="vcs-browser">https://github.com/porch-chat/porch</url>
    <update_contact>admin@porch.chat</update_contact>
    <provides>
        <binary>porch-canary</binary>
    </provides>
    <content_rating type="oars-1.1">
        <content_attribute id="social-chat">intense</content_attribute>
        <content_attribute id="social-info">intense</content_attribute>
        <content_attribute id="social-audio">intense</content_attribute>
        <content_attribute id="social-contacts">intense</content_attribute>
    </content_rating>
    <requires>
        <internet>always</internet>
    </requires>
    <supports>
        <control>keyboard</control>
        <control>pointing</control>
    </supports>
</component>
