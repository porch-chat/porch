# SPDX-License-Identifier: AGPL-3.0-or-later
[Desktop Entry]
Name=Porch
GenericName=Instant Messenger
Comment=Close-friends messaging, voice, video, and screen sharing
Exec=porch %U
TryExec=porch
Icon=porch
Type=Application
Categories=Network;InstantMessaging;Chat;
Keywords=chat;im;messaging;messenger;voip;voice;video;call;
StartupWMClass=porch
SingleMainWindow=true
StartupNotify=true
MimeType=x-scheme-handler/porch;
Terminal=false
X-GNOME-UsesNotifications=true
Actions=open-settings;new-dm;

[Desktop Action open-settings]
Name=Open Settings
Exec=porch --fluxer-task=open-settings %U

[Desktop Action new-dm]
Name=New Direct Message
Exec=porch --fluxer-task=new-dm %U
